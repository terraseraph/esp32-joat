# Copy to hardware/.env (git-ignored). Read by the in-app assistant; values are never logged or sent to the browser.
# The app writes these same lines when you enter a key in AI settings, and removes them on Forget.
# A provider is ready without any setup in the app when both its key and its model are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
NOUS_API_KEY=
NOUS_MODEL=
